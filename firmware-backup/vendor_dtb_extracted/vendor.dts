/dts-v1/;

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	model = "ASR 1826s(KAGU) Board EVB";
	compatible = "asr,1802s-evb", "asr,1802s";

	chosen {
		bootargs = "root=/dev/mtdblock5 rootfstype=squashfs init=/etc/preinit noinitrd console=ttyS0,115200 mem=128M";
	};

	aliases {
		serial0 = "/soc/apb@d4000000/uart@d4017000";
		serial1 = "/soc/apb@d4000000/uart@d4036000";
		serial2 = "/soc/apb@d4000000/uart@d4018000";
		i2c0 = "/soc/apb@d4000000/i2c@d4011000";
		i2c1 = "/soc/apb@d4000000/i2c@d4010800";
		i2c2 = "/soc/apb@d4000000/i2c@d4037000";
	};

	memory {
		device_type = "memory";
		reg = <0x4000000 0x8000000>;
	};

	clock-controller {
		compatible = "marvell,asr1802s-clock";
		reg = <0xc0100000 0x880>;
		reg-names = "dmcu";
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		compatible = "simple-bus";
		interrupt-parent = <0x01>;
		ranges;

		ddr@c0100000 {
			compatible = "marvell,devfreq-ddr";
			reg = <0xc0100000 0x880>;
			interrupts = <0x28>;
			interrupt-names = "nezas-mc-irq";
			marvell,qos;
			status = "okay";
		};

		pmu {
			compatible = "arm,cortex-a7-pmu";
			interrupts = <0x3a>;
		};

		sram@0xd100d000 {
			compatible = "mmio-sram";
			reg = <0xd100d000 0x2a00>;
			status = "okay";
			linux,phandle = <0x11>;
			phandle = <0x11>;
		};

		axi@d4200000 {
			compatible = "mrvl,axi-bus", "simple-bus";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0xd4200000 0x200000>;
			ranges;

			interrupt-controller@d4282000 {
				compatible = "mrvl,mmp-intc";
				interrupt-controller;
				#interrupt-cells = <0x01>;
				reg = <0xd4282000 0x1000>;
				mrvl,intc-nr-irqs = <0x40>;
				linux,phandle = <0x01>;
				phandle = <0x01>;
			};

			usb3phy@c0030000 {
				compatible = "asr,asr-usb3-phy";
				reg = <0xc0030000 0x1000>;
				status = "okay";
				linux,phandle = <0x02>;
				phandle = <0x02>;
			};

			usb3-0 {
				compatible = "asr,dwc3";
				status = "okay";
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				ranges;
				interrupts = <0x35>;

				dwc31@c0000000 {
					compatible = "snps,dwc3";
					status = "okay";
					reg = <0xc0000000 0x11000>;
					interrupts = <0x2c>;
					usb-phy = <0x02>;
					maximum-speed = "super-speed";
					dr_mode = "peripheral";
					phy_type = "utmi";
					lpm-qos = <0x02>;
				};
			};

			sdh@d4280000 {
				compatible = "asr,nezhas-mmc";
				reg = <0xd4280000 0x200>;
				interrupts = <0x27>;
				lpm-qos = <0x02>;
				status = "okay";
				pinctrl-names = "default", "fast";
				pinctrl-0 = <0x03 0x04 0x05>;
				pinctrl-1 = <0x06 0x07 0x05>;
				vmmc-supply = <0x08>;
				vqmmc-supply = <0x09>;
				bus-width = <0x04>;
				non-removable;
				broken-cd;
				wp-inverted;
				asr,sdh-pm-runtime-en;
				asr,sdh-host-caps-disable = <0x40000>;
				asr,sdh-quirks = <0x18000>;
				asr,sdh-quirks2 = <0x3444>;
				asr,sdh-flags = <0x01>;
				asr,sdh-dtr-data = <0x00 0x18cba80 0x632ea00 0x00 0x00 0x00 0x00 0x03 0x18cba80 0x632ea00 0x00 0x00 0x00 0x00 0x07 0x3197500 0x632ea00 0x00 0x00 0x00 0x03 0x05 0x632ea00 0xc65d400 0x00 0x00 0x00 0x00 0x06 0xc65d400 0xc65d400 0x00 0x00 0x00 0x00 0x09 0xffffffff 0x632ea00 0x00 0x00 0x00 0x00>;
			};

			sdh@d4280800 {
				compatible = "asr,nezhas-mmc";
				reg = <0xd4280800 0x200>;
				interrupts = <0x27>;
				lpm-qos = <0x02>;
				status = "disabled";
				pinctrl-names = "default", "fast", "sleep";
				pinctrl-0 = <0x0a 0x0b 0x0c>;
				pinctrl-1 = <0x0d 0x0e 0x0c>;
				pinctrl-2 = <0x0f>;
				bus-width = <0x04>;
				non-removable;
				enable-sdio-wakeup;
				clk-scaling-config = <0x23 0x0c 0xc8>;
				min-ddr-qos = <0x26160 0x4c2c0 0x61a80>;
				asr,sdh-pm-runtime-en;
				asr,sdh-quirks = <0x8000>;
				asr,sdh-quirks2 = <0x10d600>;
				asr,sdh-pm-caps = <0x01>;
				asr,sdh-host-caps2 = <0xf40000>;
				asr,sdh-flags = <0x38>;
				asr,sdh-dtr-data = <0x00 0x18cba80 0x632ea00 0x00 0x00 0x00 0x00 0x03 0x2aea540 0x5503649 0x00 0x00 0x00 0x00 0x07 0x3197500 0x632ea00 0x00 0x00 0x00 0x03 0x05 0x4f58800 0x4f58800 0x00 0x00 0x00 0x03 0x06 0xc65d400 0xc65d400 0x00 0x00 0x00 0x00 0x09 0xffffffff 0x5503649 0x00 0x00 0x00 0x00>;
				linux,phandle = <0x2c>;
				phandle = <0x2c>;
			};

			qspi@0xd420b000 {
				compatible = "asr,qspi";
				reg = <0xd420b000 0x500 0x80000000 0x8000000>;
				reg-names = "reg-map", "memory-map";
				interrupts = <0x2d>;
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				dma-enable = <0x01>;
				dma-tx-drcmr = <0x63>;
				dma-rx-drcmr = <0x61>;
				lpm-qos = <0x02>;
				status = "okay";
				qspi-nand;
				qspi-cs = <0x00>;
				qspi-txmode = [04];
				qspi-rxmode = [04];
				qspi-max_freq_mhz = <0x34>;
				marvell,ddrfreq-qos = <0x26160>;

				partition@0 {
					label = "bootloader";
					reg = <0x00 0x40000>;
					read-only;
				};

				partition@40000 {
					label = "cp_reliabledata";
					reg = <0x40000 0x20000>;
				};

				partition@60000 {
					label = "ap_reliabledata";
					reg = <0x60000 0x20000>;
				};

				partition@80000 {
					label = "cp_reliabledata_backup";
					reg = <0x80000 0x20000>;
				};

				partition@a0000 {
					label = "ap_reliabledata_backup";
					reg = <0xa0000 0x20000>;
				};

				partition@c0000 {
					label = "mep-ota";
					reg = <0xc0000 0x20000>;
				};

				partition@e0000 {
					label = "mep-ota_backup";
					reg = <0xe0000 0x20000>;
				};

				partition@100000 {
					label = "dtim-a";
					reg = <0x100000 0x40000>;
				};

				partition@140000 {
					label = "dtim-b";
					reg = <0x140000 0x40000>;
				};

				partition@180000 {
					label = "cpimage-a";
					reg = <0x180000 0xf00000>;
				};

				partition@1080000 {
					label = "cpimage-b";
					reg = <0x1080000 0xf00000>;
				};

				partition@1f80000 {
					label = "u-boot-a";
					reg = <0x1f80000 0xc0000>;
				};

				partition@2040000 {
					label = "u-boot-b";
					reg = <0x2040000 0xc0000>;
				};

				partition@2100000 {
					label = "kernel-a";
					reg = <0x2100000 0x500000>;
				};

				partition@2600000 {
					label = "kernel-b";
					reg = <0x2600000 0x500000>;
				};

				partition@2b00000 {
					label = "rootfs-a";
					reg = <0x2b00000 0x1400000>;
				};

				partition@3f00000 {
					label = "rootfs-b";
					reg = <0x3f00000 0x1400000>;
				};

				partition@5300000 {
					label = "oem_data-a";
					reg = <0x5300000 0x600000>;
				};

				partition@5900000 {
					label = "oem_data-b";
					reg = <0x5900000 0x600000>;
				};

				partition@5f00000 {
					label = "asr_flag";
					reg = <0x5f00000 0xc0000>;
				};

				partition@5fc0000 {
					label = "rsa";
					reg = <0x5fc0000 0x40000>;
				};

				partition@6000000 {
					label = "bootargs";
					reg = <0x6000000 0x40000>;
				};

				partition@6040000 {
					label = "cust_info";
					reg = <0x6040000 0x40000>;
				};

				partition@6080000 {
					label = "rootfs_data";
					reg = <0x6080000 0x00>;
				};
			};

			pmu@d4282800 {
				compatible = "marvell,mmp-pmu-apmu";
				reg = <0xd4282800 0x1b0>;
			};

			ciu@d4282c00 {
				compatible = "marvell,mmp-ciu";
				reg = <0xd4282c00 0xf0>;
			};

			pcie {
				compatible = "asr,pcie-kagu";
				status = "okay";
				device_type = "pci";
				#address-cells = <0x03>;
				#size-cells = <0x02>;
				bus-range = <0x00 0xff>;
				reg = <0xd4220000 0x800 0xd428c000 0x1000 0xd4210000 0x800 0xd4288000 0x1000>;
				reg-names = "pcie1-phy", "pcie1-config", "pcie2-phy", "pcie2-config";
				ranges = <0x82000000 0x00 0xd8050000 0xd8050000 0x00 0xc000000 0x82000000 0x00 0xe0100000 0xe0100000 0x00 0x2000000 0x81000000 0x00 0x00 0xd8010000 0x00 0x40000>;
				pcie-rst-gpio = <0x10 0x48 0x00>;
				pcie-rst-gpio2 = <0x10 0x50 0x00>;

				pcie@1,0 {
					device_type = "pci";
					assigned-addresses = <0x82000800 0x00 0xd8050000 0x00 0x8000>;
					reg = <0x800 0x00 0x00 0x00 0x00>;
					#address-cells = <0x03>;
					#size-cells = <0x02>;
					#interrupt-cells = <0x01>;
					ranges;
					interrupts = <0x13>;
					asr,pcie-port = <0x00>;
					asr,pcie-lane = <0x00>;
					lpm-qos = <0x02>;
					status = "okay";
				};

				pcie@2,0 {
					device_type = "pci";
					assigned-addresses = <0x82001000 0x00 0xe0100000 0x00 0x8000>;
					reg = <0x1000 0x00 0x00 0x00 0x00>;
					#address-cells = <0x03>;
					#size-cells = <0x02>;
					#interrupt-cells = <0x01>;
					ranges;
					interrupts = <0x12>;
					asr,pcie-port = <0x01>;
					asr,pcie-lane = <0x00>;
					lpm-qos = <0x02>;
					status = "okay";
				};
			};

			squ@d42a0800 {
				compatible = "marvell,pxa910-squ";
				reg = <0xd42a0800 0x100>;
				interrupts = <0x2e>;
				#dma-cells = <0x01>;
				asram = <0x11>;
				linux,phandle = <0x27>;
				phandle = <0x27>;
			};

			squ@d42a0000 {
				compatible = "mrvl,mmp-squ";
				reg = <0xd42a0000 0x800>;
			};

			debug {
				compatible = "mrvl,mmp-debug";
			};

			geu {
				compatible = "marvell,mmp-geu";
				reg = <0xd4201000 0x900>;
				interrupts = <0x28>;
				mrvl,geu-enable-dma = <0x01>;
				mrvl,geu-drcmr-rx = <0x44>;
				mrvl,geu-drcmr-tx = <0x45>;
				status = "okay";
				lpm-qos = <0x02>;
			};

			asr-eth@0xd4281800 {
				compatible = "asr,asr-eth-v2";
				pinctrl-names = "default", "rgmii-pins";
				pinctrl-0 = <0x12 0x13 0x14 0x15>;
				pinctrl-1 = <0x12 0x16 0x13 0x14 0x15>;
				reg = <0xd4281800 0x200>;
				interrupts = <0x0a 0x0b>;
				lpm-qos = <0x02>;
				status = "okay";
				reset-delays-us = <0x00 0x186a0 0x7a120>;
				clk-tuning-enable;
				tx-clk-config = <0x203>;
				rx-clk-config = <0x803>;
				mdio-clk-div = <0xfe>;
				linux,phandle = <0x30>;
				phandle = <0x30>;

				fixed-link {
					speed = <0x3e8>;
					full-duplex;
					phy-mode = "rgmii";
				};

				mdio-bus {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					linux,phandle = <0x31>;
					phandle = <0x31>;

					phy@0 {
						compatible = "ethernet-phy-id011a.c816", "ethernet-phy-ieee802.3-c22";
						device_type = "ethernet-phy";
						reg = <0x00>;
						phy-mode = "rgmii";
						interrupts = <0x0b>;
						tx_rx_delay = <0x0b 0x00>;
					};
				};
			};
		};

		apb@d4000000 {
			compatible = "mrvl,apb-bus", "simple-bus";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0xd4000000 0x200000>;
			ranges;

			pdma@d4000000 {
				compatible = "marvell,pdma-1.0";
				reg = <0xd4000000 0x10000>;
				interrupts = <0x2f>;
				#dma-cells = <0x02>;
				#dma-channels = <0x20>;
				#dma-channels-tz = <0x1e>;
				lpm-qos = <0x02>;
				status = "disabled";
			};

			thermal@d4013300 {
				compatible = "marvell,asr1802s-thermal";
				reg = <0xd4013300 0x3c>;
				interrupts = <0x21>;
				status = "okay";
			};

			timer@d4014000 {
				compatible = "marvell,mmp-timer";
				reg = <0xd4014000 0xd0>;
				marvell,timer-id = <0x00>;
				marvell,timer-flag = <0x00>;
				marvell,timer-fastclk-frequency = <0x319750>;
				marvell,timer-apb-frequency = <0x632ea00>;

				counter0 {
					interrupts = <0x0d>;
					marvell,timer-counter-id = <0x00>;
					marvell,timer-counter-cpu = <0x00>;
					marvell,timer-counter-frequency = <0x8000>;
					marvell,timer-counter-usage = <0x02>;
					marvell,timer-counter-rating = <0xc8>;
				};

				counter1 {
					interrupts = <0x0e>;
					marvell,timer-counter-id = <0x01>;
					marvell,timer-counter-frequency = <0x8000>;
					marvell,timer-counter-usage = <0x01>;
					marvell,timer-counter-rating = <0xc8>;
				};

				counter2 {
					interrupts = <0x0e>;
					marvell,timer-counter-id = <0x02>;
					marvell,timer-counter-frequency = <0x319750>;
					marvell,timer-counter-usage = <0x04>;
				};
			};

			uart@d4017000 {
				compatible = "mrvl,mmp-uart";
				reg = <0xd4017000 0x1000>;
				interrupts = <0x1b>;
				pinctrl-names = "default", "sleep";
				pinctrl-0 = <0x17 0x18>;
				pinctrl-1 = <0x19 0x18>;
				edge-wakeup-gpio = <0x1d>;
				lpm-qos = <0x02>;
				status = "okay";
			};

			uart@d4036000 {
				compatible = "mrvl,mmp-uart";
				reg = <0xd4036000 0x100>;
				interrupts = <0x3b>;
				uart-drcmr-rx = <0x04>;
				uart-drcmr-tx = <0x05>;
				lpm-qos = <0x02>;
				status = "disabled";
				pinctrl-names = "default";
				pinctrl-0 = <0x1a 0x1b>;
			};

			uart@d4018000 {
				compatible = "mrvl,mmp-uart";
				reg = <0xd4018000 0x100>;
				interrupts = <0x1c>;
				lpm-qos = <0x02>;
				status = "disabled";
			};

			gpio@d4019000 {
				compatible = "marvell,mmp-gpio";
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				reg = <0xd4019000 0x800>;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupts = <0x31>;
				interrupt-names = "gpio_mux";
				interrupt-controller;
				#interrupt-cells = <0x02>;
				status = "okay";
				ranges;
				linux,phandle = <0x10>;
				phandle = <0x10>;

				gpio@d4019000 {
					reg = <0xd4019000 0x04>;
					gpio-ranges = <0x1c 0x00 0x37 0x20>;
				};

				gpio@d4019004 {
					reg = <0xd4019004 0x04>;
					gpio-ranges = <0x1c 0x00 0x57 0x17>;
				};

				gpio@d4019008 {
					reg = <0xd4019008 0x04>;
					gpio-ranges = <0x1c 0x03 0x6e 0x1d>;
				};

				gpio@d4019100 {
					reg = <0xd4019100 0x04>;
					gpio-ranges = <0x1c 0x00 0x8b 0x03 0x1c 0x1c 0x33 0x03>;
				};
			};

			mfpr@d401e000 {
				compatible = "marvell,mmp-mfp-leftover";
				pinctrl-names = "default";
				reg = <0xd401e000 0x280>;
				status = "okay";
			};

			edgewakeup@d4019800 {
				compatible = "mrvl,mmp-edge-wakeup";
				reg = <0xd4019800 0x10>;
				status = "okay";
			};

			i2c@d4011000 {
				compatible = "mrvl,mmp-twsi";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0xd4011000 0x60>;
				interrupts = <0x07>;
				lpm-qos = <0x03>;
				mrvl,i2c-fast-mode;
				marvell,i2c-ilcr = <0x82c469f>;
				marvell,i2c-iwcr = <0x142a>;
				pinctrl-names = "default", "gpio";
				status = "disabled";

				alc5616@1b {
					compatible = "asrmicro,alc5616";
					reg = <0x1b>;
					pinctrl-names = "default", "AUDIO_PA_PDN";
					pinctrl-0 = <0x1d>;
					pinctrl-1 = <0x1e>;
				};
			};

			i2c@d4010800 {
				compatible = "mrvl,mmp-twsi";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0xd4010800 0x60>;
				interrupts = <0x0f>;
				lpm-qos = <0x03>;
				mrvl,i2c-fast-mode;
				marvell,i2c-ilcr = <0x82c469f>;
				marvell,i2c-iwcr = <0x142a>;
				pinctrl-names = "default", "gpio";
				pinctrl-0 = <0x1f>;
				pinctrl-1 = <0x20>;
				i2c-gpio = <0x10 0x0a 0x00 0x10 0x0b 0x00>;
				status = "disabled";

				nau8810@1a {
					compatible = "marvell,nau8810";
					reg = <0x1a>;
				};
			};

			i2c@d4037000 {
				compatible = "mrvl,mmp-twsi";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0xd4037000 0x60 0xd403d300 0x10>;
				interrupts = <0x36>;
				lpm-qos = <0x03>;
				marvell,i2c-always-on;
				mrvl,i2c-fast-mode;
				marvell,i2c-ilcr = <0x82c469f>;
				marvell,i2c-iwcr = <0x142a>;
				soc-bus-reset;
				status = "okay";

				88pm801@30 {
					compatible = "marvell,88pm801";
					reg = <0x30>;
					chg_irq_from_exton;
					interrupts = <0x04>;
					interrupt-parent = <0x01>;
					interrupt-controller;
					#interrupt-cells = <0x01>;
					marvell,88pm801-irq-write-clear;
					marvell,88pm801-power-page-addr = <0x31>;
					marvell,88pm801-gpadc-page-addr = <0x32>;

					battery {
						compatible = "marvell,88pm80x-bat";
						status = "disabled";
						online-gpadc = <0x01>;
						temperature-gpadc = <0x01>;
						hi-volt-online = <0x4e2>;
						lo-volt-online = <0x14>;
						hi-volt-temp = <0x4e2>;
						lo-volt-temp = <0x12c>;
						sw-fg-use-ntc;
						full-capacity = <0x802>;
						r1-resistor = <0x28>;
						r2-resistor = <0x1e>;
						rs-resistor = <0x78>;
						roff-resistor = <0x00>;
						roff-initial-resistor = <0x00>;
						times-in-zero-degree = <0x01>;
						offset-in-zero-degree = <0x00>;
						times-in-ten-degree = <0x02>;
						offset-in-ten-degree = <0x64>;
						power-off-threshold = <0xd16>;
						safe-power-off-threshold = <0xc80>;
						online-gp-bias-curr = <0x0b>;
						soc-ramp-up-interval = <0x96>;
						tbat-threshold = <0x14 0x00 0x0a 0x28 0x2d 0x37>;
