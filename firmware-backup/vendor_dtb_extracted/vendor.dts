					pinctrl-single,input-schmitt-enable = <0x40 0x00 0x40 0x40>;
					pinctrl-single,slew-rate = <0x00 0x80>;
					linux,phandle = <0x14>;
					phandle = <0x14>;
				};

				emac_pmx_func4 {
					pinctrl-single,pins = <0x128 0x00>;
					pinctrl-single,drive-strength = <0x00 0x1c08>;
					pinctrl-single,bias-pullup = <0x8000 0x8000 0x00 0xc000>;
					pinctrl-single,bias-pulldown = <0x8000 0x8000 0x00 0xa000>;
					pinctrl-single,input-schmitt = <0x00 0x30>;
					pinctrl-single,input-schmitt-enable = <0x40 0x00 0x40 0x40>;
					pinctrl-single,slew-rate = <0x00 0x80>;
					linux,phandle = <0x15>;
					phandle = <0x15>;
				};

				usim1_pmx_func {
					pinctrl-single,pins = <0xfc 0x00>;
					pinctrl-single,drive-strength = <0x1000 0x1c08>;
					pinctrl-single,bias-pullup = <0xc000 0xc000 0x00 0xc000>;
					pinctrl-single,bias-pulldown = <0x8000 0xa000 0x8000 0xa000>;
					pinctrl-single,input-schmitt = <0x00 0x30>;
					pinctrl-single,input-schmitt-enable = <0x40 0x00 0x40 0x40>;
					pinctrl-single,slew-rate = <0x00 0x80>;
					linux,phandle = <0x39>;
					phandle = <0x39>;
				};

				usim1_pmx_func_sleep {
					pinctrl-single,pins = <0xfc 0x00>;
					pinctrl-single,drive-strength = <0x1000 0x1c08>;
					pinctrl-single,bias-pullup = <0xc000 0xc000 0x00 0xc000>;
					pinctrl-single,bias-pulldown = <0x8000 0xa000 0x8000 0xa000>;
					pinctrl-single,input-schmitt = <0x30 0x30>;
					pinctrl-single,input-schmitt-enable = <0x00 0x00 0x40 0x40>;
					pinctrl-single,slew-rate = <0x00 0x80>;
				};

				pcie_pmx_pd_off {
					pinctrl-single,pins = <0x1b8 0x00 0x1cc 0x00 0x1ec 0x00>;
					MFP_LPM_PULL_DW;
					linux,phandle = <0x2d>;
					phandle = <0x2d>;
				};

				pcie_pmx_pd_on {
					pinctrl-single,pins = <0x1b8 0x00 0x1cc 0x00 0x1ec 0x00>;
					MFP_LPM_PULL_UP;
					linux,phandle = <0x2e>;
					phandle = <0x2e>;
				};

				gpiokey_pmx_func {
					pinctrl-single,pins = <0x130 0x00 0x1a0 0x00>;
					pinctrl-single,drive-strength = <0x1000 0x1c08>;
					pinctrl-single,bias-pullup = <0xc000 0xc000 0x00 0xc000>;
					pinctrl-single,bias-pulldown = <0x8000 0xa000 0x8000 0xa000>;
					pinctrl-single,input-schmitt = <0x00 0x30>;
					pinctrl-single,input-schmitt-enable = <0x40 0x00 0x40 0x40>;
					pinctrl-single,slew-rate = <0x00 0x80>;
					linux,phandle = <0x36>;
					phandle = <0x36>;
				};

				ctrl_ntc_gpio {
					pinctrl-single,pins = <0xd8 0x01>;
					pinctrl-single,drive-strength = <0x1000 0x1c08>;
					pinctrl-single,bias-pullup = <0xc000 0xc000 0x00 0xc000>;
					pinctrl-single,bias-pulldown = <0x8000 0xa000 0x8000 0xa000>;
					pinctrl-single,input-schmitt = <0x00 0x30>;
					pinctrl-single,input-schmitt-enable = <0x40 0x00 0x40 0x40>;
					pinctrl-single,slew-rate = <0x00 0x80>;
					linux,phandle = <0x22>;
					phandle = <0x22>;
				};
			};

			acipc@d401d000 {
				compatible = "mrvl,mmp-acipc";
				reg = <0xd401d000 0x100>;
				interrupts = <0x14>;
				interrupt-names = "IPC_AP_MUX";
				status = "okay";
			};

			seh {
				compatible = "mrvl,seh";
				reg = <0xd4016000 0xd0 0xd403d300 0x04>;
				interrupts = <0x1e>;
				interrupt-names = "AP_TIMER2_3";
				watchdog-type = <0x01>;
				timer-num = <0x02>;
				match-num = <0x00>;
				status = "okay";
			};

			cp-load {
				compatible = "marvell,cp_load";
				cp-type = <0x30393838>;
				lpm-qos = <0x02>;
				status = "okay";
			};

			data-path {
				compatible = "marvell,data-path";
				version = <0x01>;
				status = "okay";
			};

			pmu@d4050000 {
				compatible = "marvell,mmp-pmu-mpmu";
				reg = <0xd4050000 0x2060>;
			};

			apbsp@d4090000 {
				compatible = "marvell,mmp-apb-spare";
				reg = <0xd4090000 0x118>;
			};

			ripc1@d403d100 {
				compatible = "mrvl,mmp-sulog";
				reg = <0xd403d100 0x20 0xd4050210 0x04>;
				interrupts = <0x38>;
				interrupt-names = "RIPC1_INT";
				status = "okay";
			};

			pxa-ssp-dai@1 {
				compatible = "mrvl,pxa-ssp-dai";
				reg = <0x01 0x00>;
				pinctrl-names = "default", "ssp";
				pinctrl-0 = <0x25>;
				pinctrl-1 = <0x26>;
				ssp-gpio = <0x10 0x15 0x00 0x10 0x16 0x00 0x10 0x17 0x00 0x10 0x18 0x00>;
				dmas = <0x27 0x01 0x27 0x00>;
				dma-names = "rx", "tx";
				asram = <0x11>;
				platform_driver_name = "tdma_platform";
				burst_size = <0x04>;
				playback_period_bytes = <0x800>;
				playback_buffer_bytes = <0x1000>;
				capture_period_bytes = <0x800>;
				capture_buffer_bytes = <0x1000>;
				linux,phandle = <0x32>;
				phandle = <0x32>;
			};
		};
	};

	shared-timer {
		compatible = "marvell,timer1";
		dev_name = "timer1_TS";
		version = "build1";
		reg = <0xd403a000 0xd0>;
		status = "okay";
	};

	profile {
		compatible = "marvell,profile";
		marvell,profile-number = <0x00>;
	};

	leds {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		compatible = "gpio-leds";
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <0x28>;

		led@1 {
			label = "led_signal1";
			gpios = <0x10 0x46 0x00>;
			linux,default-trigger = "default-off";
			reg = <0x00>;
		};

		led@2 {
			label = "led_signal2";
			gpios = <0x10 0x4d 0x00>;
			linux,default-trigger = "rfkill0";
			reg = <0x01>;
		};

		led@3 {
			label = "led_signal3";
			gpios = <0x10 0x4e 0x00>;
			default-trigger = "heartbeat";
			reg = <0x02>;
		};

		led@4 {
			label = "red";
			gpios = <0x10 0x3a 0x00>;
			default-trigger = "heartbeat";
			reg = <0x02>;
		};

		led@5 {
			label = "blue";
			gpios = <0x10 0x45 0x00>;
			default-trigger = "heartbeat";
			reg = <0x02>;
		};

		led@6 {
			label = "led_wifi";
			gpios = <0x10 0x3e 0x00>;
			default-trigger = "heartbeat";
			reg = <0x02>;
		};

		led@7 {
			label = "led_wifi_5G";
			gpios = <0x10 0x3f 0x00>;
			default-trigger = "heartbeat";
			reg = <0x02>;
		};

		led@8 {
			label = "led_power";
			gpios = <0x10 0x78 0x00>;
			default-state = "on";
			reg = <0x07>;
		};

		led@9 {
			label = "led_charge";
			gpios = <0x10 0x77 0x00>;
			default-state = "on";
			reg = <0x08>;
		};
	};

	sd-regulator {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <0x29>;
		regulator-name = "SDH1 VCC";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <0x10 0x0c 0x00>;
		enable-active-high;
		status = "disabled";
	};

	asr-rfkill {
		compatible = "asr,asr-rfkill";
		pinctrl-names = "off", "on";
		pinctrl-0 = <0x2a>;
		pinctrl-1 = <0x2b>;
		sd-host = <0x2c>;
		pd-gpio = <0x10 0x0b 0x00>;
		3v3-ldo-gpio = <0x10 0x0d 0x00>;
		edge-wakeup-gpio = <0x10 0x0a 0x00>;
		status = "disabled";
	};

	pcie-rfkill {
		compatible = "mrvl,pcie-rfkill";
		pinctrl-names = "off", "on";
		pinctrl-0 = <0x2d>;
		pinctrl-1 = <0x2e>;
		3v3-ldo-gpio = <0x10 0x47 0x00>;
		rst-gpio = <0x10 0x50 0x00>;
		rst-gpio2 = <0x10 0x48 0x00>;
		wifi-device = "rtl8192fr";
		status = "okay";
	};

	charger {
		status = "okay";
		compatible = "asr,eta6003-chg";
		pinctrl-names = "default";
		pinctrl-0 = <0x2f>;
		chg-ntc-gpio = <0x10 0x7b 0x00>;
	};

	mmplog {
		compatible = "marvell,mmplog-heap";
		mmplog-base = <0x1800000>;
		mmplog-size = <0x4000>;
		status = "okay";
	};

	dsa@0 {
		status = "disabled";
		compatible = "marvell,dsa";
		dsa,ethernet = <0x30>;
		dsa,mii-bus = <0x31>;
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		switch@0 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00 0x00>;

			port@0 {
				reg = <0x00>;
				label = "lan5";
			};

			port@1 {
				reg = <0x01>;
				label = "lan4";
			};

			port@2 {
				reg = <0x02>;
				label = "lan3";
			};

			port@3 {
				reg = <0x03>;
				label = "lan2";
			};

			port@6 {
				reg = <0x06>;
				label = "cpu";
				ethernet = <0x30>;

				fixed-link {
					speed = <0x64>;
					full-duplex;
				};
			};
		};
	};

	sound {
		compatible = "ASRMICRO,asrmicro-snd-card";
		ssp-controllers = <0x32>;
	};

	maxlinear-slic {
		compatible = "mrvl,maxlinear-slic";
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <0x33 0x34>;
		pinctrl-1 = <0x35 0x34>;
		rst-gpio = <0x10 0x17 0x00>;
		edge-wakeup-gpio = <0x10 0x18 0x00>;
		status = "okay";
	};

	gpio_keys {
		compatible = "gpio-keys";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x36>;

		button@1 {
			label = "RESTORE_Key";
			linux,code = <0xf6>;
			gpios = <0x10 0x31 0x01>;
			gpio-key,wakeup;
		};

		button@2 {
			label = "WPS_Key";
			linux,code = <0x211>;
			gpios = <0x10 0x15 0x01>;
		};
	};

	yt_switch {
		compatible = "motorcomm,yt9215rb";
		mii-bus = <0x31>;
		PHY_ID = <0x00>;
		status = "okay";
		wlan-port = <0x00>;
		reset-gpio = <0x10 0x13 0x00>;
	};

	rtk_switch@0 {
		compatible = "realtek,rtl8367rb";
		mii-bus = <0x31>;
		status = "okay";
		reset-gpio = <0x10 0x13 0x00>;
	};

	extern_wtd {
		compatible = "extern_watchdog_gpio";
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <0x37>;
		pinctrl-1 = <0x38>;
		wtd-trigger = <0x76>;
		wtd-feed = <0x75>;
		status = "okay";
	};

	adapter_power {
		compatible = "gpio_adapter";
		pinctrl-names = "default";
		pinctrl-0 = <0x39>;
		adapter-gpio = <0x10 0x08 0x00>;
		status = "okay";
	};

	antenna_switching {
		compatible = "gpio_antenna_switching";
		pinctrl-names = "default";
		pinctrl-0 = <0x3a>;
		main-det-gpio = <0x10 0x0a 0x00>;
		main-set-gpio = <0x10 0x32 0x00>;
		div-det-gpio = <0x10 0x0b 0x00>;
		div-set-gpio = <0x10 0x16 0x00>;
		status = "okay";
	};
};
